# ══════════════════════════════════════════════════════════════
# WMF Coffee Service — ortam değişkenleri
#
# KULLANIM:
#   cp .env.example .env
#   .env dosyasını gerçek değerlerle doldurun.
#
# .env ASLA commit edilmez (.gitignore'da zaten var).
# Bu dosya (.env.example) commit edilir — içine gerçek parola YAZMAYIN.
# ══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────────
# Atlas connection string. Parolada @ : / ? # gibi karakterler varsa
# URL-encode edin (@ → %40, # → %23).
MONGO_URI=mongodb+srv://KULLANICI:PAROLA@cluster0.btxg3i.mongodb.net/wmf_demo?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB=wmf_demo

# ─────────────────────────────────────────────
# ROBOT (Fairino)
# ─────────────────────────────────────────────
# Sahada: 192.168.1.201  |  Simülatörde: 127.0.0.1
ROBOT_IP=192.168.1.200

# ── ROBOT IO HARİTASI ────────────────────────
# Sipariş akışında kullanılan pinler. Saha kablolaması farklıysa
# yalnızca burayı değiştirin; kodda pin numarası gömülü değildir.
#
#   UYGULAMA YAZAR (DO)                ROBOT YAZAR (DI)
#   ───────────────────                ────────────────
#   DO0  bardağı al, başla             DI9  buzu aldım
#   DO7  şurup bitti, makineye yerleştir  DI8  şurup istasyonundayım
#   DO2  içecek hazır, teslim et       DI1  makineye yerleştirdim
#                                      DI3  teslim ettim
ROBOT_DO_TAKE_CUP=0
ROBOT_DO_PLACE_CUP=7
ROBOT_DO_DELIVER=2

ROBOT_DI_CUP_PLACED=1
ROBOT_DI_DELIVERED=3
ROBOT_DI_AT_SYRUP=8
ROBOT_DI_ICE_TAKEN=9

# ── SİSTEM DEĞİŞKENLERİ (SysVar) ─────────────
# Robota siparişin TİPİNİ bildirir: bardağı almadan önce hangi
# istasyonlara uğrayacağını bu değişkenlerden okur.
#
# ⚠️  SDK aralığı [1~20] — 0 GEÇERSİZDİR. Robot programındaki
# "SysVar0/SysVar1" adlandırması burada 1 ve 2'ye karşılık gelir;
# robot tarafındaki değişken indeksi bununla aynı olmalıdır.
#
#   SysVar1 = 1  → şurup istasyonuna uğra
#   SysVar2 = 1  → buz istasyonuna uğra
#   SysVar3 = 0  → yalnızca buz al
#   SysVar3 = 1  → buz + su al
#
# SysVar3 yalnızca SysVar2=1 iken anlamlıdır: robot buz haznesinden
# ne alacağını kendi bilemez, önceden bildirilir.
ROBOT_SYSVAR_SYRUP=1
ROBOT_SYSVAR_ICE=2
ROBOT_SYSVAR_ICE_TYPE=3

# SysVar yazıldıktan SONRA, DO yazılmadan ÖNCE beklenen süre (saniye).
# İkisi ayrı XML-RPC çağrılarıyla gider; DO0'ı erken gören robot
# SysVar'ın eski değerini okuyup yanlış istasyona gidebilir.
ROBOT_SYSVAR_SETTLE=0.5

# Ara istasyon beklemeleri (saniye). Robotun buz alma / şurup
# istasyonuna gitme hareketini kapsamalıdır.
ICE_WAIT_TIMEOUT=90.0
SYRUP_WAIT_TIMEOUT=90.0

# ─────────────────────────────────────────────
# WMF KAHVE MAKİNESİ (CM-Remote)
# ─────────────────────────────────────────────
COFFEE_MACHINE_IP=192.168.1.111
COFFEE_MACHINE_PORT=25000
COFFEE_MACHINE_TOKEN=0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────
# SYRUP DISPENSER (LogoSurup)
# ─────────────────────────────────────────────
SYRUP_HOST=192.168.1.155
SYRUP_PORT=5000
SYRUP_TIMEOUT=15.0

# Sipariş başına akıtılacak standart doz (mL).
#
# ⚠️  Bu değer yalnızca kanal İLK OLUŞTURULURKEN uygulanır. Doz
# veritabanında kanal başına tutulduğu için, burayı sonradan
# değiştirmek mevcut kanalları GÜNCELLEMEZ — onları /stock sayfasındaki
# "Doz (ml)" alanından değiştirin.
SYRUP_DEFAULT_DOSE_ML=18.0

# ─────────────────────────────────────────────
# VERİTABANI — ÇİFT KATMAN
# ─────────────────────────────────────────────
# Tüm yazmalar önce yerel SQLite'a gider (anlık, her zaman erişilebilir).
# MongoDB'ye aktarım arka planda bir kuyruk üzerinden yapılır.
#
# Böylece internet koptuğunda kiosk çalışmaya devam eder; bağlantı
# gelince bekleyen kayıtlar sırayla aktarılır. Hiçbir kayıt kaybolmaz.
#
# Yerel veritabanı dosyası (göreliyse backend/wmf/ altına açılır)
SQLITE_PATH=data/kiosk.db

# Kuyruğun MongoDB'ye boşaltılma sıklığı (saniye)
SYNC_INTERVAL=20

# Tek turda en fazla kaç kayıt aktarılsın
SYNC_BATCH=200

# MongoDB tamamen kapatılabilir — yalnızca yerel çalışma.
# Kurulum/test aşamasında veya bulut hesabı olmayan sahalarda kullanışlı.
MONGO_ENABLED=true

# ─────────────────────────────────────────────
# LOGLAMA
# ─────────────────────────────────────────────
# Kayıtlar hem konsola hem dosyaya yazılır:
#   logs/backend.log   tüm kayıtlar
#   logs/error.log     yalnızca WARNING ve üstü
#
# Dosyalar boyut sınırına ulaşınca döndürülür; disk dolmaz.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_MB=10
LOG_BACKUPS=5

# ─────────────────────────────────────────────
# GÜVENLİK
# ─────────────────────────────────────────────
# Yönetici uçlarını (stok yenileme, robot DO yazma, program durdurma)
# koruyan token. Frontend'in /stock sayfası bunu X-Admin-Token
# başlığında gönderir.
#
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# BOŞ BIRAKILIRSA koruma devre dışı kalır ve uygulama başlarken
# uyarı basar. Sahaya çıkarken mutlaka doldurun.
ADMIN_TOKEN=0123456789abcdefg01234567890

# CORS. Virgülle ayrılmış origin listesi.
# Kiosk + yönetici tabletinin adresleri. "*" YAZMAYIN.
CORS_ORIGINS=http://192.168.1.44:5173,http://localhost:5173,http://192.168.1.44:8088,http://localhost:8088

# ─────────────────────────────────────────────
# SİPARİŞ AKIŞI ZAMAN AŞIMLARI (saniye)
# ─────────────────────────────────────────────
COFFEE_OVERALL_TIMEOUT=120.0
COFFEE_RECV_TIMEOUT=20.0
COFFEE_SILENT_ROUNDS=6
DI_WAIT_TIMEOUT=60.0
ROBOT_MODE_SWITCH_TIMEOUT=10.0
