# ══════════════════════════════════════════════════════════════
# Docker Compose — kök dizin değişkenleri
#
# Bu dosya YALNIZCA docker-compose.yml için. Backend'in kendi
# ayarları backend/wmf/.env dosyasındadır (ayrı).
#
# KULLANIM:
#   cp .env.docker.example .env
#   (değerleri düzenleyin)
#   docker compose up -d --build
# ══════════════════════════════════════════════════════════════

# Kiosk tarayıcısının backend'e erişeceği adres.
#
# ⚠️ Bu "backend" (konteyner adı) DEĞİL — kiosk'un fiziksel olarak
# ulaşabileceği adres olmalı. Tarayıcı isteği host makinesinden çıkar.
#
#   • Aynı makinede test:   http://localhost:8000
#   • Ağdaki başka cihaz:   http://192.168.1.44:8000  (host'un LAN IP'si)
#
# Değiştirince frontend'i yeniden build edin (--build), çünkü Vite bu
# değeri derleme anında gömer.
KIOSK_API_URL=http://localhost:8000

# /stock yönetim sayfasının backend'e göndereceği token.
# backend/wmf/.env içindeki ADMIN_TOKEN ile AYNI olmalı.
KIOSK_ADMIN_TOKEN=
