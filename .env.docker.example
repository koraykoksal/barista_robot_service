# ══════════════════════════════════════════════════════════════
# Docker Compose — kök dizin değişkenleri
#
# Bu dosya YALNIZCA docker-compose.yml için. Backend'in kendi
# ayarları backend/wmf/.env dosyasındadır (ayrı).
#
# KULLANIM:
#   cp .env.docker.example .env
#   (değerleri düzenleyin)
#   docker compose up -d --build
# ══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# KİOSK'UN BACKEND ADRESİ  (ZORUNLU)
# ─────────────────────────────────────────────
# ⚠️  BURAYA "localhost" YAZMAYIN.
#
# Bu değer kiosk tarayıcısının indirdiği JavaScript'in İÇİNE gömülür.
# Tarayıcı sunucunun kendisinde çalışmıyorsa "localhost" onun KENDİ
# makinesini işaret eder ve arayüz backend'e hiç ulaşamaz.
#
# Doğru değer: sunucunun LAN adresi + backend portu.
#   sunucunun IP'sini öğrenmek için:  hostname -I
#
#   KIOSK_API_URL=http://192.168.1.44:8000
KIOSK_API_URL=http://SUNUCU_IP:8000

# ─────────────────────────────────────────────
# PORTLAR
# ─────────────────────────────────────────────
# Host üzerinde hangi portlardan yayınlanacak. Konteyner içi portlar
# sabittir (backend 8000, frontend 80); burada yalnızca dış port değişir.
#
#   Arayüz : http://<sunucu-ip>:${FRONTEND_PORT}
#   API    : http://<sunucu-ip>:${BACKEND_PORT}
#
# ⚠️  Bunları değiştirirseniz İKİ yeri birden güncelleyin:
#     1. KIOSK_API_URL (yukarıda) — backend portunu içerir
#     2. backend/wmf/.env → CORS_ORIGINS — frontend adresini içermeli
BACKEND_PORT=8000
FRONTEND_PORT=8088

# ─────────────────────────────────────────────
# YÖNETİCİ
# ─────────────────────────────────────────────
# /stock sayfasının backend'e göndereceği token.
# backend/wmf/.env içindeki ADMIN_TOKEN ile AYNI olmalı; eşleşmezse
# stok yazma işlemleri 401 döner.
KIOSK_ADMIN_TOKEN=

# /stock sayfasının giriş parolası. Boş bırakılırsa koddaki varsayılan
# ("wmf2024") derlemeye girer.
# ⚠️  Bu parola tarayıcıda çalışan bir sabittir, gerçek koruma DEĞİLDİR —
#     yalnızca personelin yanlışlıkla girmesini engeller. Asıl koruma
#     yukarıdaki token'dır.
KIOSK_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# SAAT DİLİMİ
# ─────────────────────────────────────────────
# Konteynerler varsayılan olarak UTC çalışır; log saatleri sunucununkiyle
# tutmazsa olay incelemesi zorlaşır.
TZ=Europe/Istanbul
