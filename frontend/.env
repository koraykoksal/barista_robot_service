# ══════════════════════════════════════════════════════════════
# Kiosk arayüzü — ortam değişkenleri
#
# KULLANIM:
#   cp .env.example .env
#
# Vite yalnızca VITE_ önekli değişkenleri istemciye aktarır.
#
# ⚠️  BU DEĞERLER TARAYICIYA GÖNDERİLİR — derlenmiş pakette açıkça
#     görünürler. Buraya asla gerçek sır koymayın. Yönetici token'ı
#     istisnadır: kapalı kiosk ağında yalnızca /stock sayfasını
#     korumak için kullanılır, kamuya açık bir dağıtımda değil.
# ══════════════════════════════════════════════════════════════

# Backend adresi. Sondaki eğik çizgi olsa da olmasa da çalışır.
#
# Not: "localhost" yerine IP tercih edin. Bazı sistemlerde localhost
# önce IPv6'ya (::1) çözülür, uvicorn ise IPv4'te dinler ve bağlantı
# sessizce reddedilir.
VITE_API_URL=http://192.168.1.44:8000

# Yönetici token'ı — backend .env dosyasındaki ADMIN_TOKEN ile AYNI olmalı.
# /stock sayfasının yazma işlemleri bunu X-Admin-Token başlığında gönderir.
# Backend'de /stock/refill ve /stock/thresholds bu başlığı doğruluyor;
# eşleşmezse 401 döner.
VITE_ADMIN_TOKEN=

# /stock sayfasına giriş parolası.
# ⚠️  Tarayıcıda çalışan bir sabittir, derlenmiş pakette görünür ve
#     gerçek bir koruma DEĞİLDİR — yalnızca yanlışlıkla girişi engeller.
#     Asıl koruma yukarıdaki token'dır.
VITE_ADMIN_PASSWORD=wmf2024

# Sipariş durumu yoklama aralığı (ms).
# Backend SSE destekliyorsa arayüz onu tercih eder, bu değer yedek yoldur.
VITE_ORDER_POLL_MS=800

# Makine / stok / robot durumu yoklama aralıkları (ms)
VITE_MACHINE_POLL_MS=1000
VITE_STOCK_POLL_MS=5000
VITE_ROBOT_POLL_MS=2000

# ═════════════════════════════════════════════
# MENÜ KATEGORİLERİ
# ═════════════════════════════════════════════
# Ana sayfada hangi kategorinin görüneceği. Kahve makinesi olan ama
# dondurma ünitesi olmayan bir kurulumda dondurmayı kapatmak için
# kod değişikliği gerekmez.
#
# Boş bırakılırsa kategori AÇIK sayılır.
#
# Yalnızca tek kategori açıksa seçim ekranı atlanır ve doğrudan o
# listeye girilir; geri butonu da gizlenir.
#
# URL karşılığı:  ?categories=coffee
#                 ?categories=coffee,ice_cream
VITE_CATEGORY_COFFEE=true
VITE_CATEGORY_ICECREAM=true

# ═════════════════════════════════════════════
# ÇEVRİMDIŞI TEST MODU
# ═════════════════════════════════════════════
# Backend, kahve makinesi ve robot olmadan tasarımı denemek için.
# Sahteye alınan servisler için HİÇBİR ağ isteği yapılmaz; yanıtları
# src/api/mock.js üretir.
#
# ⚠️  DEV SUNUCUSUNU YENİDEN BAŞLATIN. Vite .env dosyasını yalnızca
#     sunucu açılırken okur; düzenleyip sayfayı yenilemek yetmez.
#
# 💡 Yeniden başlatmak istemiyorsanız URL parametresi kullanın —
#    anında etki eder ve .env'i ezer:
#       http://localhost:5173/?offline=1
#       http://localhost:5173/?offline=1&scenario=machine-error
#       http://localhost:5173/?offline=1&live=stock
#       http://localhost:5173/?mock=machine,robot
#
# Kabul edilen değerler: true / 1 / yes / on   (büyük-küçük harf farketmez)

# ── Genel anahtar ────────────────────────────
# Aşağıdaki servis bazlı ayarların varsayılanı. Tek başına true
# yapmanız yeterli: hepsi sahteye geçer, hiç ağ trafiği olmaz.
VITE_OFFLINE=false

# ── Servis bazlı ayarlar ─────────────────────
# Genel anahtarı servis servis ezer. Boş bırakılırsa VITE_OFFLINE
# değeri geçerli olur.
#
# Karma çalışma örnekleri:
#
#   Makine ve robot masanızda yok, ama backend + MongoDB çalışıyor:
#       VITE_OFFLINE=false
#       VITE_OFFLINE_MACHINE=true
#       VITE_OFFLINE_ROBOT=true
#
#   Her şey sahte olsun ama gerçek stok verisiyle çalışayım:
#       VITE_OFFLINE=true
#       VITE_OFFLINE_STOCK=false
#
# Hangi uçlar hangi servise ait:
#   machine → /machine/*
#   robot   → /robot/*
#   stock   → /stock/*
#   syrup   → /syrup/*
#   order   → /order_standart, /order/status/*, /check_beverage
#
#VITE_OFFLINE_MACHINE=
#VITE_OFFLINE_ROBOT=
#VITE_OFFLINE_STOCK=
#VITE_OFFLINE_ORDER=
#VITE_OFFLINE_SYRUP=

# ── Senaryo ──────────────────────────────────
# Sahte servislerin hangi durumu taklit edeceği.
# URL'de ?scenario=... ile de verilebilir.
#   ok               her şey yolunda (varsayılan)
#   no-service       backend'e hiç ulaşılamıyor
#   machine-offline  kahve makinesi çevrimdışı
#   machine-error    makine engelleyici hata veriyor
#   cleaning         makine temizlik modunda
#   robot-manual     robot manuel modda
#   low-stock        süt ve çikolata eşiğin altında (kısmi kısıt)
#   out-of-stock     bardak bitti (tam kilit)
#   order-error      sipariş demleme sırasında hata veriyor
VITE_OFFLINE_SCENARIO=ok

# ── Hız ──────────────────────────────────────
# Sipariş simülasyonu hızı. URL'de ?speed=... ile de verilebilir.
# 1 = gerçek zamanlı (Latte 40 sn sürer). 0.2 = beş kat hızlı.
VITE_OFFLINE_SPEED=1
